# Required. OpenAI API key for the weather agent's model.
OPENAI_API_KEY=your-api-key

# Required. Oracle application user (docker-compose.yaml creates this user).
ORACLE_DATABASE_USER=mastra

# Required. Password for the Oracle application user.
ORACLE_DATABASE_PASSWORD=your-oracle-password

# Required. Oracle connect string. Use <oracle-host>:1521/FREEPDB1 on Railway.
ORACLE_DATABASE_CONNECT_STRING=localhost:1521/FREEPDB1
